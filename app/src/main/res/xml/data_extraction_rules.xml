<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rules for cloud backup and phone-to-phone transfer. Only these files are copied; the settings file
     (with the encrypted API key) is never copied; the user enters the key again on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="elements.json" />
        <include domain="file" path="memories.json" />
        <include domain="file" path="reminders.json" />
        <include domain="file" path="tasks.json" />
        <include domain="file" path="habits.json" />
        <include domain="file" path="countdowns.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="elements.json" />
        <include domain="file" path="memories.json" />
        <include domain="file" path="reminders.json" />
        <include domain="file" path="tasks.json" />
        <include domain="file" path="habits.json" />
        <include domain="file" path="countdowns.json" />
    </device-transfer>
</data-extraction-rules>
